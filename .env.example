# Copy this file to .env and fill in all values before running docker compose
# Never commit .env to git

# ── Database ──────────────────────────────────────────────────
DB_PASSWORD=

# ── Redis ─────────────────────────────────────────────────────
REDIS_PASSWORD=

# ── Weaviate ──────────────────────────────────────────────────
WEAVIATE_API_KEY=

# ── JWT ───────────────────────────────────────────────────────
# REQUIRED in every environment — the app refuses to start without it.
# Minimum 32 characters. Generate with:
#   python -c "import secrets; print(secrets.token_hex(64))"
JWT_SECRET_KEY=

# ── Bootstrap admin (first-run only) ─────────────────────────
# Leave BOOTSTRAP_ADMIN_PASSWORD blank to skip creating a bootstrap admin.
# When set outside development it must be at least 12 characters.
BOOTSTRAP_ADMIN_EMAIL=admin@yourdomain.com
BOOTSTRAP_ADMIN_PASSWORD=

# ── Registration ──────────────────────────────────────────────
# Self-service signup is OFF by default. When enabled, new accounts are
# created inactive with no permissions and must be approved by an admin
# (PATCH /users/{id}/activate) before they can sign in.
SIGNUP_ENABLED=false
# Optional comma-separated email-domain allowlist for signup and OAuth.
SIGNUP_ALLOWED_DOMAINS=

# ── Environment ───────────────────────────────────────────────
# Anything other than development/dev/local/test/testing/ci is treated as
# production and enables the strict secret, cookie and CORS checks. An unset
# value means production.
DEPLOYMENT_ENV=development

# ── BI read-only DB user ──────────────────────────────────────
# The BI Agent executes SQL written by an LLM. It runs as this role and there
# is no fallback to the application owner — leave both blank to disable the
# agent (its endpoints then return 503).
#
#   CREATE ROLE bi_readonly LOGIN PASSWORD '<pass>';
#   GRANT USAGE ON SCHEMA kirana_kart TO bi_readonly;
#   GRANT SELECT ON ALL TABLES IN SCHEMA kirana_kart TO bi_readonly;
#   ALTER DEFAULT PRIVILEGES IN SCHEMA kirana_kart
#       GRANT SELECT ON TABLES TO bi_readonly;
BI_DB_USER=bi_readonly
BI_DB_PASSWORD=

# ── LLM ───────────────────────────────────────────────────────
LLM_API_KEY=

# ── OAuth ─────────────────────────────────────────────────────
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

# ── PII encryption ────────────────────────────────────────────
PII_ENCRYPTION_KEY=

# ── SMTP ──────────────────────────────────────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# ── Grafana ───────────────────────────────────────────────────
GRAFANA_ADMIN_PASSWORD=

# Migration owner URL is only supplied to the deploy job, not runtime pods.
MIGRATION_DATABASE_URL=
# Freshdesk webhook HMAC is required; unsigned payloads are rejected.
FRESHDESK_WEBHOOK_SECRET=

# Comma-separated CIDRs of trusted HTTP proxies only; never client networks.
# Empty ignores forwarding headers. Configure from the actual LB/nginx network.
TRUSTED_PROXY_CIDRS=
